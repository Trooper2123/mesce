DATABASE_URL=postgresql://mesce:mesce@localhost:5432/mesce
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Bootstrap opcional: coordenadores legados ativos são preservados por auth0_sub.
MESCE_COORDINATOR_EMAILS=
# openssl rand -hex 32; nunca versionar a chave real.
MESCE_DATA_KEY_HEX=

# Callback já usado pelo projeto Auth0 existente
MESCE_AUTH0_CALLBACK_PATH=/api/auth/callback
# Somente Preview, nunca Production
MESCE_AUTH_MODE=auth0
MESCE_DEV_PASSWORD=
MESCE_DEV_SESSION_SECRET=
# Entregas permanecem desativadas por padrão. Configure somente em ambiente controlado.
MESCE_DELIVERY_OUTBOX_ENABLED=false
MESCE_EMAIL_SEND_ENABLED=false
MESCE_PUSH_ENABLED=false
MESCE_SMTP_HOST=
MESCE_SMTP_PORT=587
MESCE_SMTP_USER=
MESCE_SMTP_PASSWORD=
MESCE_SMTP_FROM=
MESCE_VAPID_PUBLIC_KEY=
MESCE_VAPID_PRIVATE_KEY=
MESCE_VAPID_SUBJECT=mailto:admin@example.org
CRON_SECRET=
